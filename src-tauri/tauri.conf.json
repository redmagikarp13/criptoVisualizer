{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CriptoVisualizer",
  "version": "0.1.7",
  "identifier": "app.criptovisualizer.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CriptoVisualizer",
        "url": "index.html",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "backgroundColor": [11, 15, 25, 255],
        "backgroundThrottling": "disabled",
        "devtools": true
      },
      {
        "label": "widget",
        "title": "CriptoVisualizer Widget",
        "url": "index.html?view=widget",
        "width": 380,
        "height": 520,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "visible": false,
        "skipTaskbar": true,
        "transparent": true,
        "backgroundColor": [11, 15, 25, 255],
        "backgroundThrottling": "disabled",
        "devtools": true
      }
    ],
    "security": {
      "csp": "default-src 'self' tauri: http://tauri.localhost 'unsafe-inline' 'unsafe-eval'; script-src 'self' tauri: http://tauri.localhost 'unsafe-inline' 'unsafe-eval'; worker-src 'self' tauri: http://tauri.localhost blob:; style-src 'self' tauri: http://tauri.localhost 'unsafe-inline'; img-src 'self' tauri: http://tauri.localhost data: https:; font-src 'self' tauri: http://tauri.localhost data:; connect-src 'self' ipc: http://ipc.localhost tauri: http://tauri.localhost https: wss:; object-src 'none'; base-uri 'self'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "shortDescription": "Mercado cripto, indicadores e análise contextual",
    "category": "Finance",
    "windows": { "nsis": { "installMode": "currentUser", "languages": ["PortugueseBR"] } },
    "macOS": { "minimumSystemVersion": "12.0" }
  }
}
